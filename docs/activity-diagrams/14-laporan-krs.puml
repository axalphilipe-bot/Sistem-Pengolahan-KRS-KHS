@startuml activity-14-laporan-krs
skinparam backgroundColor #F5F5F5
skinparam activity {
  BackgroundColor #FFE066
  BorderColor #333333
  FontSize 11
}
skinparam activityDiamond {
  BackgroundColor #FFE066
  BorderColor #333333
}

title Diagram Laporan KRS\n(LaporanKrsController)

|Admin|
start
:Buka Laporan KRS\n(GET /admin/laporan-krs);

|Admin|
:Input filter\n(search NIM/nama, status);

|Sistem|
:Query Krs::with mahasiswa, matkul;
:Filter & pagination;
:Hitung statistik\n(total, pending, disetujui, ditolak);
:Tampilkan tabel laporan;

|Admin|
if (Export?) then (PDF)
  :Klik Export PDF\n(/admin/laporan-krs/pdf);
  |Sistem|
  :Generate PDF;
  :Download file;
elseif (Excel) then
  :Klik Export Excel\n(/admin/laporan-krs/excel);
  |Sistem|
  :KrsExport Excel download;
else (Lihat saja)
  :Selesai melihat laporan;
endif
stop

@enduml
