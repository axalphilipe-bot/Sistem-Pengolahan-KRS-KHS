@startuml activity-09-export-pdf-khs
skinparam backgroundColor #F5F5F5
skinparam activity {
  BackgroundColor #FFE066
  BorderColor #333333
  FontSize 11
}
skinparam activityDiamond {
  BackgroundColor #FFE066
  BorderColor #333333
}

title Diagram Export PDF KHS\n(KrsController::exportKhsPdf)

|Mahasiswa|
start
:Buka Menu KHS\n(GET /khs);
:Klik Unduh PDF\n(GET /khs/pdf);

|Sistem|
:getKhsData()\n(nilai published);
if (Data mahasiswa ada?) then (Tidak)
  |Mahasiswa|
  :Redirect login;
  stop
else (Ya)
  :Load view mahasiswa.khs_pdf;
  :Generate PDF DomPDF\n(A4 portrait);
  :Download file\nKHS_{NIM}.pdf;
  |Mahasiswa|
  :Browser menerima file PDF;
  stop
endif

@enduml
